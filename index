<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>SECCO | Sistema de Inspección Técnica</title>
  <style>
    :root {
      --bg: #0b0b0e;
      --card: rgba(255,255,255,.06);
      --card-2: rgba(255,255,255,.09);
      --line: rgba(255,255,255,.12);
      --text: rgba(255,255,255,.92);
      --muted: rgba(255,255,255,.68);
      --brand: #ffd200;
      --ok: #22c55e;
      --no: #ef4444;
      --radius: 16px;
      --shadow: 0 12px 40px rgba(0,0,0,.35);
      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
    }

    * { box-sizing: border-box; transition: all 0.2s ease; }
    body { margin: 0; background-color: var(--bg); color: var(--text); font-family: var(--font); padding: 20px 18px 140px; }
    .wrap { max-width: 850px; margin: 0 auto; }

    .brand { font-weight: 800; font-size: 22px; margin-bottom: 20px; letter-spacing: -1px; }
    .brand span { color: var(--brand); }

    .score-card {
      background: linear-gradient(145deg, var(--card-2), rgba(0,0,0,0.4));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 30px;
      margin-bottom: 32px;
      text-align: center;
      opacity: 0.1;
      filter: blur(10px);
      pointer-events: none;
    }
    .score-card.revealed { opacity: 1; filter: blur(0); border-color: var(--brand); pointer-events: auto; }
    .score-number { font-size: 64px; font-weight: 800; line-height: 1; margin: 5px 0; color: var(--muted); }
    .verdict-box { margin-top: 10px; padding: 10px 20px; border-radius: 8px; font-weight: 800; font-size: 13px; text-transform: uppercase; background: rgba(255,255,255,0.03); border: 1px solid var(--line); }

    .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 25px; }
    .meta-input { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
    .meta-input label { display: block; font-size: 9px; color: var(--brand); text-transform: uppercase; font-weight: 800; margin-bottom: 4px; }
    .meta-select, .meta-input input { width: 100%; background: transparent; border: none; color: var(--text); font-weight: 700; outline: none; font-family: var(--font); font-size: 15px; appearance: none; }
    option { background: #1a1a1e; color: #fff; }

    .section-block { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; margin-bottom: 25px; }
    .section-tag { color: var(--brand); font-weight: 800; font-size: 10px; text-transform: uppercase; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; }
    .section-tag::after { content: ""; flex: 1; height: 1px; background: var(--line); }

    .check-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .check-row span { font-size: 14px; opacity: 0.9; max-width: 50%; }

    .selector { display: flex; gap: 4px; justify-content: flex-end; }
    .pill { font-size: 9px; font-weight: 700; padding: 6px 12px; border-radius: 6px; background: var(--card-2); border: 1px solid var(--line); color: var(--muted); cursor: pointer; text-transform: uppercase; white-space: nowrap; }
    .pill.active { background: var(--brand); color: #000; border-color: var(--brand); }

    .textarea { width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--line); border-radius: 10px; padding: 12px; color: var(--text); margin-top: 10px; font-size: 13px; font-family: var(--font); outline: none; resize: none; min-height: 60px; margin-bottom: 10px; }

    .action-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 25px; background: rgba(11, 11, 14, 0.95); backdrop-filter: blur(15px); border-top: 1px solid var(--line); display: flex; justify-content: center; z-index: 1000; }
    .btn-submit { width: 100%; max-width: 450px; background: var(--card-2); color: var(--muted); border: none; padding: 20px; border-radius: 14px; font-weight: 800; text-transform: uppercase; cursor: not-allowed; }
    .btn-submit.ready { background: var(--brand); color: #000; cursor: pointer; box-shadow: 0 8px 24px rgba(255,210,0,0.2); }

    @media (max-width: 600px) { .check-row { flex-direction: column; align-items: flex-start; gap: 10px; } .selector { width: 100%; justify-content: flex-start; } }
  </style>
</head>
<body>

<div class="wrap">
  <div class="brand">SEC<span>CO</span></div>

  <div class="score-card" id="mainScoreCard">
    <div class="score-label">INDICE DE SALUD TECNICA</div>
    <div class="score-number" id="scoreNum">--%</div>
    <div id="verdictStatus" class="verdict-box">INSPECCION EN CURSO</div>
  </div>

  <div class="meta-grid">
    <div class="meta-input">
      <label>Unidad / Patente</label>
      <select class="meta-select" id="unidad" onchange="checkIntegrity()">
        <option value="" disabled selected>Seleccionar...</option>
        <option value="JLLJ99-Berlingo">JLLJ99-Berlingo</option>
        <option value="KLVS61-Berlingo">KLVS61-Berlingo</option>
        <option value="FGGB68-Partner">FGGB68-Partner</option>
        <option value="NB5462-Swift">NB5462-Swift</option>
      </select>
    </div>
    <div class="meta-input">
      <label>Kilometraje</label>
      <input type="number" id="km" placeholder="000000" oninput="checkIntegrity()">
    </div>
    <div class="meta-input">
      <label>Mecánico / Conductor</label>
      <select class="meta-select" id="mecanico" onchange="checkIntegrity()">
        <option value="" disabled selected>Seleccionar...</option>
        <option value="Maverick Novoa">Maverick Novoa</option>
        <option value="Felipe Torres">Felipe Torres</option>
        <option value="Héctor Vejar">Héctor Vejar</option>
        <option value="Fernando Leal">Fernando Leal</option>
      </select>
    </div>
  </div>

  <section class="section-block">
    <div class="section-tag">1. Niveles</div>
    <div class="check-row"><span>Aceite motor</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Bajo</div></div></div>
    <div class="check-row"><span>Refrigerante</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Bajo</div></div></div>
    <div class="check-row"><span>Líquido frenos</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="5" onclick="sel(this)">Bajo</div><div class="pill" data-pts="0" onclick="sel(this)">Oscuro</div></div></div>
    <div class="check-row"><span>Limpia parabrisas</span><div class="selector"><div class="pill" data-pts="5" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Bajo</div></div></div>
  </section>

  <section class="section-block">
    <div class="section-tag">2. Fugas</div>
    <div class="check-row"><span>Fuga aceite motor</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Fuga refrigerante</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Fuga caja/transmisión</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <textarea class="textarea" id="obs_fugas" placeholder="Observaciones de fugas..."></textarea>
  </section>

  <section class="section-block">
    <div class="section-tag">3. Motor</div>
    <div class="check-row"><span>Arranque normal</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Motor regula parejo</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Ruidos anómalos</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Vibración excesiva</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <textarea class="textarea" id="obs_motor" placeholder="Observaciones de motor..."></textarea>
  </section>

  <section class="section-block">
    <div class="section-tag">4. Frenos</div>
    <div class="check-row"><span>Pedal firme</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Frenado parejo</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Sin vibración al frenar</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Sin ruidos al frenar</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Pastillas delanteras</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Buenas</div><div class="pill" data-pts="5" onclick="sel(this)">Medias</div><div class="pill" data-pts="0" onclick="sel(this)">Gastadas</div></div></div>
    <div class="check-row"><span>Pastillas traseras</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Buenas</div><div class="pill" data-pts="5" onclick="sel(this)">Medias</div><div class="pill" data-pts="0" onclick="sel(this)">Gastadas</div></div></div>
    <div class="check-row"><span>Discos</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="5" onclick="sel(this)">Rayados</div><div class="pill" data-pts="0" onclick="sel(this)">Reborde</div></div></div>
    <div class="check-row"><span>Freno mano retiene</span><div class="selector"><div class="pill" data-pts="20" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <textarea class="textarea" id="obs_frenos" placeholder="Observaciones de frenos..."></textarea>
  </section>

  <section class="section-block">
    <div class="section-tag">5. Neumáticos</div>
    <div class="check-row"><span>Presión correcta</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Desgaste parejo</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Desgaste irregular</span><div class="selector"><div class="pill" data-pts="15" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Tajo / Hernias</span><div class="selector"><div class="pill" data-pts="20" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Profundidad dibujo</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Buena</div><div class="pill" data-pts="5" onclick="sel(this)">Media</div><div class="pill" data-pts="0" onclick="sel(this)">Baja</div></div></div>
    <div class="check-row"><span>Tuercas firmes</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">Sí</div><div class="pill" data-pts="0" onclick="sel(this)">No</div></div></div>
    <div class="check-row"><span>Repuesto</span><div class="selector"><div class="pill" data-pts="5" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">No</div><div class="pill" data-pts="5" onclick="sel(this)">N/A</div></div></div>
    <textarea class="textarea" id="obs_neumaticos" placeholder="Observaciones de neumáticos..."></textarea>
  </section>

  <section class="section-block">
    <div class="section-tag">6. Eléctrico Básico</div>
    <div class="check-row"><span>Bajas / Altas</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Falla</div></div></div>
    <div class="check-row"><span>Intermitentes</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Falla</div></div></div>
    <div class="check-row"><span>Luces freno</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Falla</div></div></div>
    <div class="check-row"><span>Bocina</span><div class="selector"><div class="pill" data-pts="5" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Falla</div></div></div>
    <textarea class="textarea" id="obs_electrico" placeholder="Observaciones de sistema eléctrico..."></textarea>
  </section>

  <section class="section-block">
    <div class="section-tag">7. Sueltos / Defectuosos</div>
    <div class="check-row"><span>Plásticos / Cubre motor</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Suelto</div></div></div>
    <div class="check-row"><span>Broches faltantes</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">No</div><div class="pill" data-pts="0" onclick="sel(this)">Sí</div></div></div>
    <div class="check-row"><span>Escape / Ruido</span><div class="selector"><div class="pill" data-pts="10" onclick="sel(this)">OK</div><div class="pill" data-pts="0" onclick="sel(this)">Suelto</div></div></div>
    <textarea class="textarea" id="obs_otros" placeholder="Otros defectos detectados..."></textarea>
  </section>

  <div class="action-bar">
    <button class="btn-submit" id="btnSubmit" onclick="finalizar()">Complete la inspección</button>
  </div>
</div>

<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxwLk4Y-UKAvyTYsZDpFrJzjmFV0bBldUOOalHmPyo4m-yrq8PTMLxiM45tce7U0FaTDg/exec';

  function sel(e) {
    e.parentElement.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    e.classList.add('active');
    checkIntegrity();
  }

  function checkIntegrity() {
    const total = document.querySelectorAll('.selector').length;
    const answered = document.querySelectorAll('.pill.active').length;
    const btn = document.getElementById('btnSubmit');
    const metaOk = document.getElementById('unidad').value && document.getElementById('km').value && document.getElementById('mecanico').value;

    if (answered === total && metaOk) {
      calculateScore();
      btn.disabled = false;
      btn.className = "btn-submit ready";
      btn.innerText = "REGISTRAR INFORME FINAL";
    } else {
      btn.innerText = "FALTAN " + (total - answered) + " PUNTOS";
      btn.disabled = true;
      btn.className = "btn-submit";
    }
  }

  function calculateScore() {
    let current = 0; let max = 0;
    document.querySelectorAll('.selector').forEach(sel => {
      const pts = Array.from(sel.querySelectorAll('.pill')).map(p => parseInt(p.getAttribute('data-pts')));
      max += Math.max(...pts);
    });
    document.querySelectorAll('.pill.active').forEach(a => current += parseInt(a.getAttribute('data-pts')));
    
    const percent = Math.round((current / max) * 100);
    const num = document.getElementById('scoreNum');
    const verd = document.getElementById('verdictStatus');

    document.getElementById('mainScoreCard').classList.add('revealed');
    num.innerText = percent + '%';

    if (percent >= 92) { verd.innerText = "APTO PARA SALIR"; verd.style.color = "var(--ok)"; num.style.color = "var(--ok)"; }
    else if (percent >= 75) { verd.innerText = "APTO CON OBSERVACION"; verd.style.color = "var(--brand)"; num.style.color = "var(--brand)"; }
    else { verd.innerText = "NO APTO - REPARACION URGENTE"; verd.style.color = "var(--no)"; num.style.color = "var(--no)"; }
  }

  async function finalizar() {
    const btn = document.getElementById('btnSubmit');
    btn.innerText = "ENVIANDO REPORTE...";
    btn.disabled = true;

    const data = {
      unidad: document.getElementById('unidad').value,
      km: document.getElementById('km').value,
      mecanico: document.getElementById('mecanico').value,
      salud: document.getElementById('scoreNum').innerText,
      veredicto: document.getElementById('verdictStatus').innerText,
      observaciones: {
        fugas: document.getElementById('obs_fugas').value,
        motor: document.getElementById('obs_motor').value,
        frenos: document.getElementById('obs_frenos').value,
        neumaticos: document.getElementById('obs_neumaticos').value,
        electrico: document.getElementById('obs_electrico').value,
        otros: document.getElementById('obs_otros').value
      },
      fecha: new Date().toLocaleString('es-CL')
    };

    try {
      await fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: JSON.stringify(data) });
      alert("Informe registrado correctamente.");
      location.reload();
    } catch (e) {
      alert("Error al conectar con el servidor.");
      btn.disabled = false;
    }
  }
</script>

</body>
</html>
